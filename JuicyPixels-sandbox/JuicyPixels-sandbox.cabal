cabal-version: 3.0

name:           JuicyPixels-sandbox
version:        0.1.0.0
synopsis:       JPEG, PNG and WebP decoding in a WebAssembly sandbox
description:    JPEG, PNG and WebP decoding of JuicyPixels images by libjpeg-turbo, libspng and libwebp compiled to WebAssembly and translated to C by wasm2c, with bounds checks, a memory limit, an iteration budget and a deadline for each decode.
category:       Codec, Image
author:         simplex.chat
maintainer:     chat@simplex.chat
copyright:      2026 SimpleX Chat Ltd
license:        BSD-3-Clause AND Apache-2.0 AND MIT AND IJG AND Zlib AND BSD-2-Clause AND libpng-2.0
license-files:
    LICENSE
    cbits/wasm2c/LICENSE
    cbits/wasm2c/simde/COPYING
    cbits/licenses/mozjpeg/LICENSE.md
    cbits/licenses/mozjpeg/README.ijg
    cbits/licenses/libspng/LICENSE
    cbits/licenses/miniz/LICENSE
    cbits/licenses/libwebp/COPYING
    cbits/licenses/libwebp/PATENTS
build-type:     Simple
extra-source-files:
    CHANGELOG.md
    cbits/*.h
    cbits/image-wasm.c
    cbits/wasm2c/*.h
    cbits/wasm2c/*.inc
    cbits/wasm2c/simde/*.h
    cbits/wasm2c/simde/wasm/*.h
    guest/*.c
    guest/*.h

source-repository head
  type: git
  location: https://github.com/simplex-chat/hs-jpeg-turbo

common options
  default-extensions:
      BangPatterns
      BlockArguments
      ImportQualifiedPost
      LambdaCase
      NamedFieldPuns
      OverloadedStrings
      TupleSections
      TypeApplications
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  default-language: Haskell2010

library
  import: options
  exposed-modules:
      Codec.Picture.Sandbox
  hs-source-dirs:
      src
  ghc-options: -Wmissing-export-lists
  cc-options: -O2 -DWASM_RT_MEMCHECK_BOUNDS_CHECK=1 -DWASM_RT_STACK_DEPTH_COUNT=1 -DWASM_RT_MAX_CALL_STACK_DEPTH=128 -DWASM_RT_GROW_FAILED_HANDLER=sandbox_grow_failed
  include-dirs:
      cbits
      cbits/wasm2c
  c-sources:
      cbits/clock.c
      cbits/host.c
      cbits/module.c
      cbits/wasm2c/wasm-rt-mem-impl.c
  build-depends:
      JuicyPixels
    , base >=4.7 && <5
    , bytestring
    , transformers
    , vector
  if os(android) || (os(osx) && arch(aarch64))
    cc-options: -O3

test-suite JuicyPixels-sandbox-test
  import: options
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      SandboxTest
  hs-source-dirs:
      test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-tool-depends:
      tasty-discover:tasty-discover
  build-depends:
      JuicyPixels
    , JuicyPixels-jpeg-turbo
    , JuicyPixels-libwebp
    , JuicyPixels-sandbox
    , JuicyPixels-spng
    , base >=4.7 && <5
    , bytestring
    , directory
    , filepath
    , jpeg-turbo
    , tasty
    , tasty-discover
    , tasty-hunit
    , vector
